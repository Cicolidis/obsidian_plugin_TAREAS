# Se reconstruye con `npm install`.
node_modules/
dist/
*.log

# Basura de macOS.
.DS_Store

# El bundle: lo produce `npm run build` y cambia entero en cada compilación.
# Si alguna vez se publica, main.js va adjunto a la release, no al repositorio.
main.js

# El volcado del outline de Obsidian para `npm run test:corpus`. Lleva los
# títulos reales de las notas y este repositorio es público.
outline-obsidian.local.json

# Las rutas reales de las notas de tareas, para `medir` y `test:corpus`.
# Estuvo trackeado hasta el 29/09/2026 y por eso sigue en la historia.
# La forma está en `notas-de-tareas.ejemplo.json`.
notas-de-tareas.json

# El vault de prueba: se arma con `npm run vault:prueba` desde test/vault-semilla/.
tareas-vault-prueba/

# Los permisos que Claude Code va aprobando en esta máquina. Los del proyecto
# están en `.claude/settings.json`, que sí va.
.claude/settings.local.json
